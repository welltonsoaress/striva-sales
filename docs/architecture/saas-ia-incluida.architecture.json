{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "IA incluída e operação SaaS",
    "subtitle": "Identidade, permissões, respostas lógicas e continuidade humana",
    "output": "saas-ia-incluida.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "cliente",
      "label": "Cliente"
    },
    {
      "id": "app",
      "label": "Aplicação e workers"
    },
    {
      "id": "db",
      "label": "Banco"
    },
    {
      "id": "operacao",
      "label": "Operação"
    }
  ],
  "mainPath": [
    "signup",
    "prepare",
    "activation",
    "account",
    "runtime",
    "reservation",
    "channel",
    "balance"
  ],
  "nodes": [
    {
      "id": "signup",
      "lane": "cliente",
      "col": 0,
      "type": "ui",
      "label": "/clinicas → signup (segmento sugerido/editável) → fn_provision_self_service: organização autenticada"
    },
    {
      "id": "prepare",
      "lane": "app",
      "col": 1,
      "type": "service",
      "label": "business-agent.ts → templates, memória canônica, funil e agenda real"
    },
    {
      "id": "activation",
      "lane": "app",
      "col": 2,
      "type": "service",
      "label": "Ativar: e-mail + WhatsApp + Turnstile servidor + elegibilidade"
    },
    {
      "id": "account",
      "lane": "db",
      "col": 3,
      "type": "database",
      "label": "organization_ai_accounts + ai_trial_claims: período e limites"
    },
    {
      "id": "runtime",
      "lane": "app",
      "col": 4,
      "type": "service",
      "label": "managedSettings / run-model-call: finalidade, preço validado, chave do servidor e arquivos próprios"
    },
    {
      "id": "reservation",
      "lane": "db",
      "col": 5,
      "type": "database",
      "label": "fn_ai_reserve → 10 créditos, franquia + extras, resposta lógica e partes; saldo em transação"
    },
    {
      "id": "automation",
      "lane": "app",
      "col": 4,
      "type": "service",
      "label": "automation engine: contrato verificado; withAutomationResponse reserva antes do modelo, trava de sessão e identidade por ação"
    },
    {
      "id": "channel",
      "lane": "app",
      "col": 6,
      "type": "service",
      "label": "Cadeia before-send → transporte → confirmação / incerteza"
    },
    {
      "id": "balance",
      "lane": "cliente",
      "col": 7,
      "type": "ui",
      "label": "ResponseBalance / Faturamento: créditos, renovação, contratação e pacotes extras"
    },
    {
      "id": "cost",
      "lane": "db",
      "col": 6,
      "type": "database",
      "label": "llm_calls: custo operacional, tarifa usada, origem histórica plataforma/legado e custo desconhecido"
    },
    {
      "id": "payment",
      "lane": "app",
      "col": 2,
      "type": "service",
      "label": "process-hotmart → acesso pago, franquia e reversão idempotentes"
    },
    {
      "id": "admin",
      "lane": "operacao",
      "col": 8,
      "type": "ui",
      "label": "/admin: todas as empresas, financeiro, IA e pendências"
    },
    {
      "id": "adjustment",
      "lane": "db",
      "col": 9,
      "type": "database",
      "label": "fn_admin_ai_account: motivo, referência e api_audit_log"
    },
    {
      "id": "notice",
      "lane": "db",
      "col": 7,
      "type": "database",
      "label": "fn_ai_commercial_notice → Central + contexto de pausa humana"
    },
    {
      "id": "human",
      "lane": "cliente",
      "col": 8,
      "type": "ui",
      "label": "Inbox: atendimento humano e retomada dentro do período contratado"
    },
    {
      "id": "reconcile",
      "lane": "app",
      "col": 9,
      "type": "service",
      "label": "Replay/admin reconcilia recibos; lock impede liberar automação viva, timeout conserva reserva"
    },
    {
      "id": "paywall",
      "lane": "cliente",
      "col": 3,
      "type": "ui",
      "label": "SubscriptionAccessGate: fim do teste sem fechar; faturamento, ajuda e dados preservados"
    },
    {
      "id": "payment-status",
      "lane": "cliente",
      "col": 12,
      "type": "ui",
      "label": "/pagamento/retorno e PaymentStatus: referência HttpOnly, organização autenticada e aprovação no servidor"
    },
    {
      "id": "commercial-outbox",
      "lane": "db",
      "col": 10,
      "type": "database",
      "label": "commercial_notices: evento único por empresa/membro, lease e cancelamento de avisos superados"
    },
    {
      "id": "commercial-email",
      "lane": "app",
      "col": 11,
      "type": "service",
      "label": "cron/commercial-notices → sendEmail/Resend: idempotência, erros nomeados e conferência administrativa"
    },
    {
      "id": "plan-request",
      "lane": "cliente",
      "col": 10,
      "type": "ui",
      "label": "Faturamento → change-request: suporte humano, nenhuma cobrança automática"
    },
    {
      "id": "plan-quote",
      "lane": "operacao",
      "col": 11,
      "type": "ui",
      "label": "Admin assume chamado e prepara proposta; cancelamento anterior confirmado e aceite no faturamento"
    },
    {
      "id": "global-connection",
      "lane": "db",
      "col": 4,
      "type": "database",
      "label": "platform_ai_credentials cifradas + settings: modelo comum, falha fechada e sem chave no navegador"
    },
    {
      "id": "manual-plan",
      "lane": "app",
      "col": 3,
      "type": "service",
      "label": "fn_admin_set_commercial_plan: ator full, prazo, consumo preservado e referência idempotente"
    },
    {
      "id": "recovery-default",
      "lane": "db",
      "col": 1,
      "type": "database",
      "label": "fn_seed_lead_recovery: rascunho 1h/24h/48h, templates próprios e cancelamento ao responder"
    }
  ],
